# Copy this file to .env and fill in your own values.
# API_URL can be a root URL or an OpenAI-compatible /v1 URL.
# Keep .env private; it is ignored by .gitignore.

API_URL=https://your-api-provider.example
API_KEY=replace-with-your-key
MODEL=gpt-5.5

# OpenAI-style names also work:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_MODEL=gpt-4.1-mini

# Optional: lower this to reduce token cost, raise it if lecture details are missed.
# AI_SOURCE_MAX_CHARS=6000
